<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ManuTrack funziona solo in HTTPS (app installabile e notifiche push lo richiedono).
    # Dietro il proxy dell'hosting si controlla anche X-Forwarded-Proto.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Per le pagine valgono le intestazioni di ManuTrack (app/Http/Middleware/SecurityHeaders.php,
    # con la fotocamera solo dove serve): qui si aggiungono solo se mancano, cioè ai file statici.
    # Con "always set" Apache sostituirebbe quelle dell'app (docs/SICUREZZA.md).
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty Referrer-Policy "same-origin"
    Header setifempty X-Frame-Options "DENY"
    Header setifempty Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header setifempty Strict-Transport-Security "max-age=31536000" env=HTTPS

    # File compilati con l'impronta nel nome: cache lunga
    <FilesMatch "\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
