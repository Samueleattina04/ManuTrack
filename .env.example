# =====================================================================
#  ManuTrack — configurazione di un'installazione
#  Copia questo file in ".env" e compila i valori. Ogni cliente ha il suo .env.
#  Guida completa: docs/INSTALLAZIONE.md
# =====================================================================

APP_NAME=ManuTrack
# production sul server, local in sviluppo
APP_ENV=production
# Generata in automatico dall'installazione se vuota
APP_KEY=
# Mai "true" su un server raggiungibile da internet
APP_DEBUG=false
# Indirizzo pubblico, sempre in https
APP_URL=https://manutenzione.example.com
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database MySQL 8 o MariaDB 10.6+ (in DirectAdmin: MySQL Management) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=utente_manutrack
DB_USERNAME=utente_manutrack
DB_PASSWORD=

# --- Sessioni e cache su file: funzionano anche prima dell'installazione ---
SESSION_DRIVER=file
SESSION_LIFETIME=480
# Sessioni cifrate con APP_KEY nei file di storage/ (cambiandolo chi è collegato deve rientrare)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
# CACHE_PREFIX=

# --- Code: "database" (consigliato, smaltite dal cron ogni minuto) oppure "sync" ---
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- File caricati: "local" (cartella storage, privata) oppure "s3" ---
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Posta (in DirectAdmin: E-Mail Accounts; server smtp del dominio) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=manutrack@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="manutrack@example.com"
MAIL_FROM_NAME="ManuTrack"

# =====================================================================
#  Impostazioni ManuTrack
# =====================================================================

# Valori iniziali dell'azienda (poi modificabili da Impostazioni › Azienda)
MANUTRACK_COMPANY_NAME="La mia azienda"
# rame (Grafite e Rame), ciano (Acciaio e Ciano), indaco (Ardesia e Indaco)
MANUTRACK_PALETTE=rame
# Colore accento personalizzato (es. #E8915A); vuoto = quello della palette
MANUTRACK_ACCENT=

# Codice per l'installazione dal browser (/install). Scrivi un valore lungo e
# casuale prima di aprire /install; al termine viene cancellato da solo.
MANUTRACK_INSTALL_TOKEN=

# Aggiornamenti: il cron applica da solo un pacchetto caricato, solo se completo
MANUTRACK_AUTO_UPDATE=true
# Minuti di attesa dopo l'ultima modifica dei file prima di aggiornare
MANUTRACK_UPDATE_SETTLE_MINUTES=5
# true = mette in cache anche la configurazione (le modifiche a .env richiedono poi "manutrack:update --force")
MANUTRACK_CACHE_CONFIG=false

# Copie del database (create prima di ogni aggiornamento): quante conservarne
MANUTRACK_BACKUPS_KEEP=5

# Foto e documenti: dimensione massima per file in MB (vale anche il limite di PHP del server)
MANUTRACK_UPLOAD_MAX_MB=20
# Modelli 3D (GLB) delle macchine: dimensione massima in MB (non oltre i limiti di caricamento di PHP)
MANUTRACK_MODEL_MAX_MB=20

# Installazione dimostrativa: dati fittizi e azzeramento ogni notte
MANUTRACK_DEMO=false

# --- Sicurezza (docs/SICUREZZA.md) ---
# Proxy di cui fidarsi per l'IP del client: vuoto = solo questo server e le reti private
# (Nginx davanti ad Apache). Con un proxy o CDN esterno: i suoi indirizzi, separati da virgole
MANUTRACK_TRUSTED_PROXIES=
# Content-Security-Policy: enforce (consigliato), report (solo segnalata in console), off
MANUTRACK_CSP=enforce
# Strict-Transport-Security in secondi (solo in https); 0 = non inviarla
MANUTRACK_HSTS_SECONDS=31536000

# --- Notifiche push: generate con "php artisan manutrack:vapid" ---
VAPID_SUBJECT="mailto:manutrack@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

VITE_APP_NAME="${APP_NAME}"
